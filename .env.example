# Copie este arquivo para .env e preencha com os valores do SEU projeto Supabase.
# Sem .env, o app funciona só no modo demonstração.
#
# Apenas valores PÚBLICOS vão aqui (a chave "anon" ou "publishable").
# NUNCA coloque a chave service_role / secret: ela ignora o RLS.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-publica
